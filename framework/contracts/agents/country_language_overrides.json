  "fiscal_equivalents": {
    "_comment": "Normaliza el nombre local de la autoridad/sistema fiscal al canónico 'autoridad_fiscal'. Permite que el mismo intent funcione en cualquier país.",
    "CO": { "dian":   "autoridad_fiscal", "rut co":   "registro_fiscal", "muisca": "sistema_fiscal" },
    "MX": { "sat":    "autoridad_fiscal", "cfdi":     "factura_electronica", "comprobante fiscal digital": "factura_electronica" },
    "AR": { "afip":   "autoridad_fiscal", "arca":     "autoridad_fiscal", "cae":    "validacion_fiscal" },
    "PE": { "sunat":  "autoridad_fiscal", "cpe":      "factura_electronica", "sire":   "sistema_fiscal" },
    "CL": { "sii":    "autoridad_fiscal", "folios":   "timbres_fiscales",  "dte":    "factura_electronica" },
    "VE": { "seniat": "autoridad_fiscal" },
    "EC": { "sri":    "autoridad_fiscal", "ride":     "factura_electronica" },
    "BO": { "sin":    "autoridad_fiscal", "nota fiscal":"factura" },
    "UY": { "dgi":    "autoridad_fiscal" },
    "GT": { "sat gt": "autoridad_fiscal", "fel":      "factura_electronica" },
    "PA": { "dgi pa": "autoridad_fiscal" },
    "DO": { "dgii":   "autoridad_fiscal", "ecf":      "factura_electronica" }
  },

