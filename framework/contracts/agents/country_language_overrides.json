{
  "meta": {
    "name": "country_language_overrides",
    "version": "2.0.0",
    "language": "es",
    "updated": "2026-05-05",
    "goal": "Ontología LATAM universal. Normaliza modismos, regionalismos, equivalentes fiscales y vocabulario sectorial para que el mismo motor semántico sirva a cualquier país latino y cualquier tipo de empresa.",
    "structure": {
      "global": "Reglas y sinónimos neutros aplicables a todo LATAM",
      "countries.<CC>": "Overrides por código ISO-3166-1 alpha-2",
      "fiscal_equivalents.<CC>": "Nombre local de la autoridad fiscal → 'autoridad_fiscal' canónico",
      "sectors.<name>": "Vocabulario sectorial universal (commerce, health, production, services, legal, education, hospitality)",
      "how_to_add_country": "Añadir entrada en 'countries' y 'fiscal_equivalents'. No tocar PHP.",
      "how_to_add_sector": "Añadir entrada en 'sectors' con clave snake_case. Sin reiniciar servidor."
    }
  },

  "global": {
    "typo_rules": [
      { "match": "misto",      "replace": "mixto" },
      { "match": "servivios",  "replace": "servicios" },
      { "match": "prodcuto",   "replace": "producto" },
      { "match": "factrua",    "replace": "factura" },
      { "match": "formlario",  "replace": "formulario" },
      { "match": "clente",     "replace": "cliente" },
      { "match": "provedor",   "replace": "proveedor" },
      { "match": "imventario", "replace": "inventario" },
      { "match": "cobransa",   "replace": "cobranza" },
      { "match": "pagare",     "replace": "pagare" },
      { "match": "vendido",    "replace": "vendido" }
    ],
    "synonyms": {
      "cel":    "telefono",
      "celu":   "telefono",
      "cello":  "telefono",
      "correo": "email",
      "mail":   "email",
      "nit":    "documento",
      "wsp":    "whatsapp",
      "ws":     "whatsapp",
      "wasap":  "whatsapp"
    }
  },

