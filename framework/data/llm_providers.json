{
  "_comment": "Fuente de verdad para providers LLM. Editar aquí para cambiar modelos, cascade y prioridades. Las API keys SIEMPRE en .env, nunca aquí.",
  "cascade": ["openrouter", "gemini", "deepseek", "mistral", "groq"],
  "primary": "openrouter",
  "secondary": "gemini",
  "providers": {
    "openrouter": {
      "class": "App\\Core\\LLM\\Providers\\OpenRouterProvider",
      "model": "qwen/qwen-2.5-coder-32b-instruct",
      "env_key": "OPENROUTER_API_KEY",
      "env_enable": "OPENROUTER_ENABLED"
    },
    "gemini": {
      "class": "App\\Core\\LLM\\Providers\\GeminiProvider",
      "model": "gemini-2.5-flash-lite",
      "env_key": "GEMINI_API_KEY",
      "env_enable": "GEMINI_ENABLED"
    },
    "deepseek": {
      "class": "App\\Core\\LLM\\Providers\\DeepSeekProvider",
      "model": "deepseek-chat",
      "env_key": "DEEPSEEK_API_KEY",
      "env_enable": "DEEPSEEK_ENABLED"
    },
    "mistral": {
      "class": "App\\Core\\LLM\\Providers\\MistralProvider",
      "model": "mistral-small-latest",
      "env_key": "MISTRAL_API_KEY",
      "env_enable": "MISTRAL_ENABLED"
    },
    "groq": {
      "class": "App\\Core\\LLM\\Providers\\GroqProvider",
      "model": "llama-3.1-8b-instant",
      "env_key": "GROQ_API_KEY",
      "env_enable": "GROQ_ENABLED"
    },
    "claude": {
      "class": "App\\Core\\LLM\\Providers\\ClaudeProvider",
      "model": "claude-3-5-haiku-latest",
      "env_key": "CLAUDE_API_KEY",
      "env_enable": "CLAUDE_ENABLED"
    }
  },
  "limits": {
    "timeout": 20,
    "max_tokens": 600
  }
}
