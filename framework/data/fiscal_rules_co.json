    {
      "id": "rete_iva",
      "name": "Retención del IVA",
      "legal_ref": "Art. 437-2 ET",
      "type": "withholding_on_tax",
      "applies_at": "document",
      "base_field": "tax_total",
      "applies_to_document_types": ["support_document"],
      "enabled": true,
      "rate": 0.15,
      "applies_when_agent": ["gran_contribuyente", "autorretenedor"],
      "_comment": "Solo cuando el comprador/agente retenedor es gran contribuyente o autorretenedor DIAN"
    },

    {
      "id": "impoconsumo_licores",
      "name": "Impuesto al Consumo — Licores y cerveza",
      "legal_ref": "Art. 512-1 ET",
      "type": "percentage_line",
      "applies_at": "line",
      "applies_to_document_types": ["sales_invoice"],
      "applies_to_product_categories": ["licores", "cerveza", "bebidas_alcoholicas"],
      "enabled": false,
      "rates": [
        { "key": "vinos_aperitivos", "rate": 0.20 },
        { "key": "licores_25_up",    "rate": 0.25 },
        { "key": "cerveza",          "rate": 0.08 }
      ],
      "default_rate_key": "licores_25_up",
      "_comment": "Activar por sector si la empresa maneja licores. Se combina con IVA."
    },

    {
      "id": "bolsas_plasticas",
      "name": "Impuesto bolsas plásticas",
      "legal_ref": "Art. 512-15 ET",
      "type": "fixed_per_unit",
      "applies_at": "line",
      "applies_to_document_types": ["sales_invoice"],
      "applies_to_product_categories": ["bolsas_plasticas"],
      "enabled": false,
      "amount_per_unit": 66,
      "_comment": "Valor 2024: $66 COP por bolsa. Actualizar según DIAN cada año."
    }

  ],

