{
  "_meta": {
    "description": "Reglas fiscales Colombia — Estatuto Tributario 2025. Editar aquí para actualizar tarifas sin tocar PHP.",
    "legal_base": "Estatuto Tributario Nacional (ET), resoluciones DIAN y acuerdos municipales vigentes.",
    "version": "2025.1",
    "country": "CO",
    "currency": "COP",
    "uvt": 49799
  },

  "rules": [

    {
      "id": "iva",
      "name": "Impuesto al Valor Agregado",
      "legal_ref": "Art. 420-513 ET",
      "type": "percentage_line",
      "applies_at": "line",
      "applies_to_document_types": ["sales_invoice", "support_document", "credit_note"],
      "enabled": true,
      "_comment": "El IVA se calcula línea a línea con tax_rate de cada línea. Este registro es informativo y permite consultas de tarifa.",
      "rates": [
        { "key": "general",    "rate": 0.19, "label": "IVA General (Art. 468 ET)" },
        { "key": "reducido",   "rate": 0.05, "label": "IVA Reducido (Art. 468-1 ET)" },
        { "key": "exento",     "rate": 0.00, "label": "Exento (Art. 477 ET)" },
        { "key": "excluido",   "rate": 0.00, "label": "Excluido (Art. 424 ET)" }
      ],
      "default_rate_key": "general"
    },

    {
      "id": "rete_fuente_compras",
      "name": "ReteFuente — Compras generales",
      "legal_ref": "Art. 401 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["compras"],
      "enabled": true,
      "threshold_uvt": 27,
      "rate": 0.025,
      "overrides": [
        {
          "_comment": "Sin factura o sin RUT",
          "condition_key": "sin_factura",
          "condition_value": true,
          "rate": 0.035
        }
      ]
    },

    {
      "id": "rete_fuente_servicios",
      "name": "ReteFuente — Servicios generales",
      "legal_ref": "Art. 392 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["servicios"],
      "enabled": true,
      "threshold_uvt": 4,
      "rate": 0.04,
      "subtype_rates": [
        { "subtype": "aseo_vigilancia",      "rate": 0.02,  "threshold_uvt": 4  },
        { "subtype": "transporte_carga",     "rate": 0.01,  "threshold_uvt": 27 },
        { "subtype": "transporte_pasajeros", "rate": 0.035, "threshold_uvt": 27 },
        { "subtype": "servicios_publicos",   "rate": 0.025, "threshold_uvt": 27 },
        { "subtype": "mantenimiento",        "rate": 0.04,  "threshold_uvt": 4  }
      ]
    },

    {
      "id": "rete_fuente_honorarios",
      "name": "ReteFuente — Honorarios y Comisiones",
      "legal_ref": "Art. 383 ET",
      "type": "withholding_conditional_rate",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["honorarios", "comisiones"],
      "enabled": true,
      "threshold_uvt": 0,
      "rate_conditions": [
        { "issuer_type": "natural", "is_declarante": true,  "rate": 0.10 },
        { "issuer_type": "natural", "is_declarante": false, "rate": 0.11 },
        { "issuer_type": "juridica",                        "rate": 0.11 }
      ],
      "default_rate": 0.11
    },

    {
      "id": "rete_fuente_arrendamiento_muebles",
      "name": "ReteFuente — Arrendamiento bienes muebles",
      "legal_ref": "Art. 395 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["arrendamiento_muebles"],
      "enabled": true,
      "threshold_uvt": 0,
      "rate": 0.04
    },

    {
      "id": "rete_fuente_arrendamiento_inmuebles",
      "name": "ReteFuente — Arrendamiento bienes inmuebles personas jurídicas",
      "legal_ref": "Art. 401 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["arrendamiento_inmuebles"],
      "enabled": true,
      "threshold_uvt": 27,
      "rate": 0.035
    },

    {
      "id": "rete_fuente_construccion",
      "name": "ReteFuente — Contratos de construcción y urbanización",
      "legal_ref": "Art. 401 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["contratos_construccion"],
      "enabled": true,
      "threshold_uvt": 27,
      "rate": 0.02
    },

    {
      "id": "rete_fuente_rendimientos",
      "name": "ReteFuente — Rendimientos financieros",
      "legal_ref": "Art. 395 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["rendimientos_financieros"],
      "enabled": true,
      "threshold_uvt": 0,
      "rate": 0.07
    },

    {
      "id": "rete_fuente_dividendos",
      "name": "ReteFuente — Dividendos gravados",
      "legal_ref": "Art. 245 ET",
      "type": "withholding",
      "applies_at": "document",
      "base_field": "subtotal",
      "applies_to_document_types": ["support_document"],
      "applies_to_concepts": ["dividendos_gravados"],
      "enabled": true,
      "threshold_uvt": 0,
      "rate": 0.20
    },

