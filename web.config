<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 1. Bloquear acceso directo a .php (excepto index.php autorizados) -->
                <rule name="BlockDirectPhpAccess" stopProcessing="true">
                    <match url="\.php$" />
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="/index\.php$" negate="true" />
                    </conditions>
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Direct PHP access denied." />
                </rule>

                <!-- 2. Bloquear carpetas sensibles (Hidden Layer) -->
                <rule name="BlockSensitiveDirs" stopProcessing="true">
                    <match url="^(docs|brain|\.agent|\.suki|storage|vendor|framework/(app|config|contracts|database|models|scripts|views)|project/(config|contracts|database|models|views)|tower/views)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access to system directories is denied." />
                </rule>

                <!-- 3. Short report URL: /r/{token} → api/reports/view (masked, no internal path) -->
                <rule name="RouteShortReport" stopProcessing="true">
                    <match url="^r/([A-Za-z0-9\-_\.]+)$" />
                    <action type="Rewrite" url="project/public/api.php?route=reports/view&amp;token={R:1}" appendQueryString="false" />
                </rule>

                <!-- 4. API Global: /api/*, /apps/api/*, /marketplace/api/*, /torre/api/*, etc. -->
                <rule name="RouteApiNested" stopProcessing="true">
                    <match url="^(torre|apps|marketplace|builder|editor)/api/(.*)$" />
                    <action type="Rewrite" url="project/public/api.php?route={R:2}" appendQueryString="true" />
                </rule>
                <rule name="RouteApiRoot" stopProcessing="true">
                    <match url="^api/(.*)$" />
                    <action type="Rewrite" url="project/public/api.php?route={R:1}" appendQueryString="true" />
                </rule>

                <!-- 5. Redirección raíz al Marketplace -->
                <rule name="DefaultRedirect" stopProcessing="true">
                    <match url="^$" />
                    <action type="Redirect" url="marketplace/" redirectType="Found" />
                </rule>

                <!-- 5. Marketplace -->
                <rule name="RouteMarketplace" stopProcessing="true">
                    <match url="^marketplace(/.*)?$" />
                    <action type="Rewrite" url="framework/public/index.php?url={R:1}" appendQueryString="true" />
                </rule>

                <!-- 6. Apps (Chat App / Dashboard) -->
                <rule name="RouteApps" stopProcessing="true">
                    <match url="^apps(/.*)?$" />
                    <action type="Rewrite" url="project/public/index.php?url={R:1}" appendQueryString="true" />
                </rule>

                <!-- 7. Torre de Control -->
                <rule name="RouteTorre" stopProcessing="true">
                    <match url="^torre(/.*)?$" />
                    <action type="Rewrite" url="tower/public/index.php?url={R:1}" appendQueryString="true" />
                </rule>

                <!-- 8. Builder (Chat Builder) -->
                <rule name="RouteBuilder" stopProcessing="true">
                    <match url="^builder(/.*)?$" />
                    <action type="Rewrite" url="project/public/index.php?url=builder" appendQueryString="true" />
                </rule>

                <!-- 9. Editor (Form JSON Editor) -->
                <rule name="RouteEditor" stopProcessing="true">
                    <match url="^editor(/.*)?$" />
                    <action type="Rewrite" url="project/public/index.php?url=editor" appendQueryString="true" />
                </rule>

                <!-- 10. Rutas de acceso del Marketplace (aliases globales) -->
                <rule name="RouteLogout" stopProcessing="true">
                    <match url="^logout(/.*)?$" />
                    <action type="Rewrite" url="framework/public/index.php?url=logout" appendQueryString="true" />
                </rule>
                <rule name="RouteBuilderLogin" stopProcessing="true">
                    <match url="^builder-login(/.*)?$" />
                    <action type="Rewrite" url="framework/public/index.php?url=builder-login" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- Páginas de error personalizadas (path relativo a la raíz del sitio) -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="404" />
            <error statusCode="404" path="/framework/views/errors/suki_error.php" responseMode="ExecuteURL" />
            <remove statusCode="403" />
            <error statusCode="403" path="/framework/views/errors/suki_error.php" responseMode="ExecuteURL" />
            <remove statusCode="500" />
            <error statusCode="500" path="/framework/views/errors/suki_error.php" responseMode="ExecuteURL" />
        </httpErrors>

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".agent" />
                    <add segment=".suki" />
                    <add segment="vendor" />
                </hiddenSegments>
                <!-- Bloquear extensiones sensibles -->
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".sqlite" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".yaml" allowed="false" />
                    <add fileExtension=".yml" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>
    </system.webServer>
</configuration>
